[Unit]
Description=LAN SPL monitoring appliance
After=network.target sound.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=spl
Group=spl
SupplementaryGroups=audio
WorkingDirectory=/opt/spl-dashboard
Environment=SPL_DATA_DIR=/var/lib/spl-dashboard
Environment=PYTHONUNBUFFERED=1
# The web UI is bundled inside the installed wheel, so SPL_WEB_DIST is not needed.
ExecStart=/opt/spl-dashboard/.venv/bin/spl-dashboard --host 0.0.0.0 --port 8000 --data-dir /var/lib/spl-dashboard
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=spl-dashboard
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Audio devices must remain available; do not enable PrivateDevices.

[Install]
WantedBy=multi-user.target
